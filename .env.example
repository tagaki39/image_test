BASE_URL=https://test.xywhaigc.top
AUTHORIZATION=Bearer replace_with_your_token
CLIENT_ID=replace_with_your_client_id

# 可长期访问的测试参考图
REFERENCE_IMAGE_URL=https://minio.test.xywhaigc.top/minio/aigc/path/to/reference.png

# 轮询配置
TASK_TIMEOUT_SECONDS=240
POLL_INTERVAL_SECONDS=5
TASK_LIST_PAGE_SIZE=100

# 是否校验最终图片URL可访问
VERIFY_OUTPUT_IMAGE=true

# 自动登录配置（可选）：配置后每次运行自动登录获取最新Token，无需手动更新AUTHORIZATION
LOGIN_USERNAME=your_test_username
LOGIN_PASSWORD=your_test_password
RSA_PUBLIC_KEY=your_rsa_public_key_base64
